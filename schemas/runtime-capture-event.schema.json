{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Gavriel-lab/everthread/schemas/runtime-capture-event.schema.json",
  "title": "Everthread Runtime Capture Event",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "source", "timestamp", "content", "privacy", "confidence", "salience"],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "source": { "type": "string", "minLength": 1 },
    "timestamp": { "type": "string", "format": "date-time" },
    "content": { "type": "string", "minLength": 1 },
    "privacy": { "enum": ["low", "medium", "high", "guarded"] },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "salience": { "type": "number", "minimum": 0, "maximum": 1 },
    "tags": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true,
      "default": []
    }
  }
}
