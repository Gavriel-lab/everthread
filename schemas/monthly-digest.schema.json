{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://everthread.dev/schemas/monthly-digest.schema.json",
  "title": "Everthread Monthly Digest",
  "type": "object",
  "required": ["schema", "month", "conversation_files", "message_blocks", "files"],
  "properties": {
    "schema": {
      "const": "everthread.monthly_digest.v0.1"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "month": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}$"
    },
    "conversation_files": {
      "type": "integer",
      "minimum": 0
    },
    "message_blocks": {
      "type": "integer",
      "minimum": 0
    },
    "privacy_note": {
      "type": "string"
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["source", "created_at", "title_hash", "message_blocks"],
        "properties": {
          "source": { "type": "string" },
          "created_at": { "type": "string" },
          "title_hash": { "type": "string" },
          "title_preview": { "type": "string" },
          "message_blocks": { "type": "integer" },
          "content_hash": { "type": "string" }
        }
      }
    }
  }
}
